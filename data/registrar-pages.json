    {
      "url": "https://registrar.ucsf.edu/deadlines",
      "path": "/deadlines",
      "slug": "deadlines",
      "title": "Deadlines - Summer 2024",
      "pageTitle": "Office of the Registrar",
      "summary": "Deadlines - Summer 2024 Fee Payment Program Session Advanced Training in Clinical Research August 1, 2024 Health Data Science August 1, 2024 Healthcare Administration & Interprofessional Leadership June 13, 2024 Pharmacy Levels 1, 2 August ",
      "bodyHtml": "<main> <div> </div> <div> <div> <div> <div> <div> <div> <div data-drupal-messages-fallback></div> </div> </div> <a tabindex=\"-1\"></a> <div> <div> <div> <article> <div> <div><h1>Deadlines - Summer 2024</h1><table><caption>Fee Payment</caption><thead><tr><th colspan=\"2\">Program</th></tr><tr><th colspan=\"2\">Session</th></tr></thead><tbody><tr><td>Advanced Training in Clinical Research</td><td>August 1, 2024</td></tr><tr><td>Health Data Science</td><td>August 1, 2024</td></tr><tr><td>Healthcare Administration &amp; Interprofessional Leadership</td><td>June 13, 2024</td></tr><tr><td>Pharmacy Levels 1, 2</td><td>August 1, 2024</td></tr><tr><td>ALL OTHER PROGRAMS</td><td>July 8, 2024</td></tr><tr><td>Summer 1 &amp; Summer Term</td><td>July 8, 2024</td></tr><tr><td>Summer 2</td><td>August 1, 2024</td></tr></tbody></table><p><br>Note: Your fee payment deadline appears on the “Summary” tab and “Fees” tab in the <a href=\"https://saa.ucsf.edu/studentportal/\" target=\"_blank\">student portal</a>.<br>&nbsp;</p><h2>Study List Filing</h2><table><thead><tr><th colspan=\"2\">Programs</th></tr></thead><tbody><tr><td>Healthcare Administration &amp; Interprofessional Leadership</td><td>April 29 to May 14</td></tr><tr><td>All Other Programs</td><td>April 29 to August 2</td></tr></tbody></table><p><br>Note: Check the \"Summary\" tab in the <a href=\"https://saa.ucsf.edu/studentportal/\" target=\"_blank\">student portal</a> for enrollment requirement and deadline.<br>&nbsp;</p><h2>Withdraw &amp; Receive Full Refund</h2><p>(please see <a href=\"https://registrar.ucsf.edu/registration/refunds\">Refunds</a>)<br>First day of instruction<br>&nbsp;</p><h2>Apply for Reduced Fee Enrollment</h2><p>must apply before paying fees &amp; not later than this deadline:<br>July 5, 2024<br>&nbsp;</p><h2>Apply for Filing Fee Status</h2><p>June 17, 2024<br>&nbsp;</p><h2>Name Changes</h2><p>August 2, 2024<br>&nbsp;</p><h2>Residency Reclassification</h2><p><strong>Effective Fall 2024</strong><br>July 17, 2024<br>&nbsp;</p><p><strong>Deadlines for future quarters are subject to change. Please check at the start of the quarter to review current deadline information.</strong></p></div> <section> </section> </div> </article> </div> </div>\n<div> <div> <div></div> </div> </div> </div> </div> </div> <div> <aside> <div> <div> <div> <h2>Quick Links</h2> <div> <div><p><a href=\"https://saa.ucsf.edu/studentportal/\" target=\"_blank\">Student Portal Login</a><br><a href=\"/academic-calendar\">Academic Calendar</a><br><a href=\"http://catalog.ucsf.edu/\" target=\"_blank\">General Catalog</a><br><a href=\"https://saa.ucsf.edu/courseschedule/\" target=\"_blank\">Schedule of Classes</a><br><a href=\"/forms\">Forms</a><br><a href=\"/registration/deadlineshome\">Deadlines</a><br><a href=\"/registration/fees\">Fees</a><br><a href=\"/registration/residency\" title=\"California Residency\">California Residency</a></p></div> </div> </div> </div> </div> </aside> </div> </div> </div> </main>",
