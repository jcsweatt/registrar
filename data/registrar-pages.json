    {
      "url": "https://registrar.ucsf.edu/transcripts/transcript-pickup",
      "path": "/transcripts/transcript-pickup",
      "slug": "transcripts-transcript-pickup",
      "title": "PDF Transcript Pickup",
      "pageTitle": "Office of the Registrar",
      "summary": "PDF Transcript Pickup Thank you for picking up a UCSF student's official PDF transcript. Please open the official PDF transcript in Adobe Reader or Adobe Acrobat",
      "bodyHtml": "<main> <div> </div> <div> <div> <div> <div> <div> <div> <div data-drupal-messages-fallback></div> </div> </div> <a tabindex=\"-1\"></a> <div> <div> <div> <article> <div> <div><h1>PDF Transcript Pickup</h1><p>Thank you for picking up a UCSF student's official PDF transcript.</p><p>Please open the official PDF transcript in Adobe Reader or Adobe Acrobat.&nbsp;The blue banner at the top of the transcript page will confirm that the UCSF Office of the Registrar has certified the document, ensuring that the document has not been altered.</p><p><a href=\"/transcript-guide-and-grading-key\">Transcript guide and grading key.</a></p><p>For questions, please <a href=\"/cdn-cgi/l/email-protection#255740424c565157445765504656430b4041501a5650474f404651187561630017157157444b5646574c5551001715754c464e505500171574504056514c4a4b\">e-mail</a> or call us (415-476-8280).</p><p>Proceed to <a href=\"https://saa.ucsf.edu/transcript-pickup/\" target=\"_blank\">pickup site</a>.</p></div> <section> </section> </div> </article> </div> </div>\n<div> <div> <div></div> </div> </div> </div> </div> </div> <div> <aside> <div> <nav role=\"navigation\" aria-labelledby=\"block-sb-nine-mainmenu-menu\"> <h2><span>Transcripts</span></h2> <ul> <li> <a href=\"/transcripts/ordering-transcripts\">Ordering Transcripts</a> </li> <li> <a href=\"/transcripts/transcripts-fees\">Fees for Transcripts</a> </li> <li> <a href=\"/transcripts/transcript-request-forms\">Transcript Request Form</a> </li> <li> <a href=\"/transcripts/transcript-pickup\" aria-current=\"page\">PDF Transcript Pickup</a> </li> <li> <a href=\"/transcripts/transcript-guide-and-grading-key\">Transcript Guide and Grading Key</a> </li> <li> <a href=\"/transcripts/catalogarchives\">Course Catalog Archives</a> </li> </ul> </nav> </div> </aside> <aside> <div> <div> <div> <h2>Quick Links</h2> <div> <div><p><a href=\"https://saa.ucsf.edu/studentportal/\" target=\"_blank\">Student Portal Login</a><br><a href=\"/academic-calendar\">Academic Calendar</a><br><a href=\"http://catalog.ucsf.edu/\" target=\"_blank\">General Catalog</a><br><a href=\"https://saa.ucsf.edu/courseschedule/\" target=\"_blank\">Schedule of Classes</a><br><a href=\"/forms\">Forms</a><br><a href=\"/registration/deadlineshome\">Deadlines</a><br><a href=\"/registration/fees\">Fees</a><br><a href=\"/registration/residency\" title=\"California Residency\">California Residency</a></p></div> </div> </div> </div> </div> </aside> </div> </div> </div> </main>",
